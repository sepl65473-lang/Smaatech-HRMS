# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (Database > Connect > Drivers in the Atlas UI).
# Must include a database name, e.g. .../smaatech_hrms?retryWrites=true&w=majority
MONGODB_URI=

PORT=4000

# Generate strong random values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Origin the frontend dev server runs on, for CORS + cookie settings.
CLIENT_ORIGIN=http://localhost:5173

# Reverse geocoding (check-in address) uses OpenStreetMap's free Nominatim
# service — no API key needed, nothing to configure here.

# Real OTP emails (password reset + login 2FA) go through Brevo's HTTP API,
# not SMTP — Render's free tier blocks all outbound SMTP ports (25/465/587),
# so a direct Gmail/SMTP connection can never reach Gmail from production.
# 1. Sign up free at brevo.com (no card needed).
# 2. Senders, Domains & Dedicated IPs > Senders > add + verify the address
#    you want emails to come from (a confirmation email is sent to it).
# 3. SMTP & API > API Keys > generate a key.
BREVO_API_KEY=
# The verified sender address from step 2 above (also used as the "from" name).
SMTP_USER=

# Demo account passwords used by `npm run seed:server` (first-time setup only).
# Choose any passwords you like — they only matter for initial local login.
SEED_ADMIN_PASS=Admin@123
SEED_HR_PASS=Manager@123
SEED_FINANCE_PASS=Finance@123
SEED_EMPLOYEE_PASS=Employee@123
