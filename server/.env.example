# Copy this file to .env and fill in real values. Never commit .env.
#
# server/src/lib/startupChecks.js validates all of this at boot and REFUSES to
# start in production if anything required is missing, placeholder, or weak.

# ── Required ─────────────────────────────────────────────────────────────────

# MongoDB connection string (Atlas: Database > Connect > Drivers).
# Must include a database name, e.g. .../smaatech_hrms?retryWrites=true&w=majority
# Use a REPLICA SET (Atlas always is): lib/transactionHelper.js needs one for the
# multi-document transactions in leave->attendance sync and F&F payout.
MONGODB_URI=

PORT=4000

# Two DIFFERENT strong random values. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Startup refuses known placeholders and anything under 32 chars in production.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Browser origin(s) allowed to call this API, comma-separated. Required in
# production: it IS the CORS allow-list, and an empty list blocks the web
# client entirely. Exact origins only — no wildcards.
CLIENT_ORIGIN=http://localhost:5173

# ── File storage ─────────────────────────────────────────────────────────────
# Attendance selfies, face-enrolment photos, rejected-verification evidence and
# HR documents.
#
#   local   — disk under server/uploads. Development only. On Render this
#             filesystem is EPHEMERAL: everything is lost on the next deploy.
#   gridfs  — stored in the MongoDB above. Durable, covered by the same
#             backups, no new provider and no new credential. Use this in
#             production.
#
# This project does NOT use S3 or any object-storage provider. STORAGE_DRIVER=s3
# is deliberately refused at startup rather than silently discarding files (the
# old code returned a fake s3:// ref without uploading anything). Adopting one
# is a business decision.
STORAGE_DRIVER=gridfs
GRIDFS_BUCKET=hrmsfiles
# Acknowledge ephemeral local storage in production instead of switching to gridfs:
# ALLOW_EPHEMERAL_STORAGE=1

# How long rejected face-verification photos are retained (biometric evidence).
# VERIFICATION_ATTEMPT_RETENTION_DAYS=90

# ── Face verification tuning ─────────────────────────────────────────────────
# Worker pool for face extraction — the most CPU-expensive request this server
# serves. Unset sizes it from the host core count, divided by cluster workers.
# FACE_WORKER_POOL_SIZE=
# Detector resolution. 320 (default) is ~35% faster than 416 and measured to
# produce an identical descriptor. Raising it only affects detection of small
# or distant faces; it never affects match strictness.
# FACE_DETECTOR_INPUT_SIZE=320

# ── Email ────────────────────────────────────────────────────────────────────
# Password-reset OTP, login 2FA and welcome mail go through Brevo's HTTP API,
# not SMTP — Render's free tier blocks all outbound SMTP ports (25/465/587).
#   1. Sign up free at brevo.com (no card needed).
#   2. Senders, Domains & Dedicated IPs > Senders > add + verify a sender address.
#   3. SMTP & API > API Keys > generate a key.
BREVO_API_KEY=
# The verified sender address from step 2 (also used as the "from" name).
SMTP_USER=
# The HRMS address put in onboarding emails. Leave unset to use the first
# CLIENT_ORIGIN entry, which is normally correct. Set it only when the address
# employees should open differs from the CORS origin (a custom domain, say).
# The welcome template used to carry a hardcoded domain that was not this
# deployment, so every new employee got a sign-in link that went nowhere.
# APP_PORTAL_URL=


# ── Operations ───────────────────────────────────────────────────────────────
# Shared secret for scraping /api/v1/metrics and /api/v1/ai/* without a user
# session (Prometheus, uptime checks). Without it those endpoints are reachable
# only by a signed-in HR Director. They are never public.
METRICS_TOKEN=

# ── Rate limiting ─────────────────────────────────────────────────────
# Layered, not purely per-IP — see src/middleware/rateLimits.js. Defaults are
# sized for ~100 employees sharing ONE office address, which is the case that
# broke the old per-IP-only scheme. Leave unset unless you have a reason.
#
# Authenticated traffic is counted per USER, so office size no longer decides
# whether people get 429s. Only raise the IP ceiling if a genuinely large site
# shares one address.
# RL_ANON_MAX=300            # unauthenticated requests per IP / 15 min
# RL_USER_MAX=600            # authenticated requests per USER / 15 min
# RL_IP_CEILING=20000        # backstop per IP across all of /api / 15 min
# RL_LOGIN_IP_MAX=200        # sign-in attempts per IP / 15 min
# RL_LOGIN_BURST_MAX=120     # sign-in attempts per IP / 1 min
# RL_LOGIN_ACCOUNT_MAX=10    # sign-in attempts per ACCOUNT / 15 min
# RL_FACE_USER_MAX=30        # face/liveness calls per user / 15 min
# RL_FACE_IP_MAX=900         # face/liveness calls per IP / 15 min
# RL_ATTENDANCE_USER_MAX=40  # attendance punches per user / 15 min
# RL_FINANCIAL_USER_MAX=60   # payout calls per user / 15 min

# Number of proxy hops in front of this server (Render/Vercel/nginx = 1).
# Getting this wrong means per-IP rate limiting buckets the whole internet
# together, or lets a client forge X-Forwarded-For to evade it.
TRUST_PROXY_HOPS=1

# Vercel preview deployments: this project's own URL prefix, so
# <prefix>-<hash>.vercel.app previews pass CORS. Leave blank to allow none.
# NEVER widen this to all of .vercel.app — that would let any attacker's
# Vercel page make credentialed calls to this API.
VERCEL_PREVIEW_PREFIX=

# Background jobs (attendance rows, leave accrual, document expiry).
# Exactly ONE process must own them. Set false on every instance that should
# not run cron; with ENABLE_CLUSTER, SCHEDULER_WORKER_ID pins the owner.
RUN_SCHEDULERS=true
# ENABLE_CLUSTER=true
# WEB_CONCURRENCY=2
# SCHEDULER_WORKER_ID=1

# Runs face descriptor extraction on the main thread instead of a worker.
# DISABLE_FACE_WORKER=false

# ── Seeding (first-time local setup only) ────────────────────────────────────
SEED_ADMIN_PASS=Admin@123
SEED_HR_PASS=Manager@123
SEED_FINANCE_PASS=Finance@123
SEED_EMPLOYEE_PASS=Employee@123

# ─── Scheduled database backup ───────────────────────────────────────────────
# Opt-in. With BACKUP_DIR unset no scheduled backup runs at all, rather than
# writing to a directory that disappears with the container.
#
# On Render this must point at a PERSISTENT DISK to be worth anything. A backup
# on the same host protects against a bad migration or a mistaken bulk update —
# not against losing the host. An off-host copy needs a destination outside this
# application.
# BACKUP_DIR=/var/data/hrms-backups
# BACKUP_CRON=0 1 * * *
# BACKUP_RETENTION_DAYS=14

# How long a notification delivery record is kept, for answering
# "was the payslip email actually sent?" after the fact.
# NOTIFICATION_DELIVERY_RETENTION_DAYS=120
